{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dangamsoft/cafe-mcp",
  "description": "Saju & BaZi (Four Pillars) charts, luck cycles, manseryeok and classics. Free with sign-in.",
  "websiteUrl": "https://24plus.ai.kr/mcp",
  "repository": {
    "url": "https://github.com/dangamsoft/cafe-mcp",
    "source": "github"
  },
  "version": "2.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.24plus.ai.kr/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@dangamsoft/cafe-mcp",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CAFE_MCP_KEY",
          "description": "Personal 24PLUS key (mcp_live_...) from https://24plus.ai.kr/my",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
