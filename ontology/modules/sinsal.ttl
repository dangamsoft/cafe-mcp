#==============================================================================
# 75 SINSAL INSTANCES (신살 75종)
# Option B: Revised Romanization for English labels
#==============================================================================

# ─── Sinsal subclasses (6 categories) ───

saju:TwelveSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:RelationalSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:FormSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:DayBasedSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:MaleficSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:BeneficSinsal a owl:Class ;
    rdfs:subClassOf saju:Sinsal .

saju:SinsalNature a owl:Class .
saju:Auspicious   a saju:SinsalNature ; rdfs:label "Gil"@en , "길(吉)"@ko .
saju:Inauspicious a saju:SinsalNature ; rdfs:label "Hyung"@en , "흉(凶)"@ko .
saju:Neutral      a saju:SinsalNature ; rdfs:label "Jung"@en , "중(中)"@ko .

saju:hasNature a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has nature"@en , "본연 길흉"@ko ;
    rdfs:domain saju:Sinsal ; rdfs:range saju:SinsalNature .

saju:alias a owl:DatatypeProperty ;
    rdfs:label "alias"@en , "별칭"@ko ;
    rdfs:range xsd:string .

