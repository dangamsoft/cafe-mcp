    saju:hasStem saju:Stem_신 ;
    saju:hasBranch saju:Branch_사 ;
    saju:cycleIndex 18 .

saju:Pillar_임오 a saju:Pillar ;
    rdfs:label "壬午"@en , "임오(壬午)"@ko ;
    saju:hanja "壬午" ; saju:hangul "임오" ;
    saju:hasStem saju:Stem_임 ;
