@prefix saju:    <https://24plus.ai.kr/ontology/saju#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

#==============================================================================
# Core: Stems, Branches, Elements, Polarity, 60 Pillars
# Module of CAFE Ontology · https://24plus.ai.kr/ontology/saju
#==============================================================================

#==============================================================================
# CORE CLASSES
#==============================================================================

saju:Pillar a owl:Class ;
    rdfs:label "Pillar"@en , "간지(干支)"@ko ;
    rdfs:comment "A combination of one heavenly stem and one earthly branch. The 60 sexagenary cycle is generated by combining 10 stems with 12 branches."@en ,
                 "천간과 지지의 조합. 10천간 × 12지지의 조합으로 60갑자가 형성된다."@ko .

saju:HeavenlyStem a owl:Class ;
    rdfs:label "Heavenly Stem"@en , "천간(天干)"@ko ;
    rdfs:comment "One of ten celestial signs: 갑을병정무기경신임계."@en ,
                 "하늘의 기운을 상징하는 10개의 글자."@ko .

saju:EarthlyBranch a owl:Class ;
    rdfs:label "Earthly Branch"@en , "지지(地支)"@ko ;
    rdfs:comment "One of twelve terrestrial signs: 자축인묘진사오미신유술해."@en ,
                 "땅의 기운을 상징하는 12개의 글자."@ko .

saju:FiveElement a owl:Class ;
    rdfs:label "Five Element"@en , "오행(五行)"@ko ;
    rdfs:comment "One of five fundamental elements: Wood, Fire, Earth, Metal, Water."@en ,
                 "목·화·토·금·수의 다섯 가지 기본 원소."@ko .

saju:Polarity a owl:Class ;
    rdfs:label "Eumyang (Polarity)"@en , "음양(陰陽)"@ko ;
    rdfs:comment "Yin or Yang, the dual aspect of all phenomena."@en ,
                 "음(陰)과 양(陽), 만물의 이중적 속성."@ko .

saju:TenGod a owl:Class ;
    rdfs:label "Sipsin"@en , "십신(十神)"@ko ;
    rdfs:comment "One of ten relational categories derived from the day master against any other stem or branch."@en ,
                 "일간을 기준으로 다른 간지와의 관계를 10가지로 분류한 개념."@ko .

saju:Pattern a owl:Class ;
    rdfs:label "Gyeokguk"@en , "격국(格局)"@ko ;
    rdfs:comment "A structural type of a birth chart, used as a primary frame for interpretation."@en ,
                 "사주 원국의 구조적 유형. 해석의 1차 틀로 사용된다."@ko .

saju:Yongshin a owl:Class ;
    rdfs:label "Yongshin"@en , "용신(用神)"@ko ;
    rdfs:comment "The element or stem chosen as the most beneficial influence for a particular birth chart."@en ,
                 "사주 원국에 가장 유익한 오행 또는 천간."@ko .

saju:Combination a owl:Class ;
    rdfs:label "Hap (Combination)"@en , "합(合)"@ko ;
    rdfs:comment "A pair or set of stems/branches that bond together, often transforming into a new element."@en ,
                 "결합 관계를 이루는 천간 또는 지지의 짝/조합. 합화시 새로운 오행으로 변할 수 있다."@ko .

saju:Clash a owl:Class ;
    rdfs:label "Chung (Clash)"@en , "충(沖)"@ko ;
    rdfs:comment "Two opposing branches or stems that conflict and weaken each other."@en ,
                 "서로 반대되어 충돌하는 천간 또는 지지의 쌍."@ko .

#==============================================================================
# OBJECT PROPERTIES
#==============================================================================

saju:hasStem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has stem"@en , "천간 보유"@ko ;
    rdfs:domain saju:Pillar ;
    rdfs:range  saju:HeavenlyStem .

saju:hasBranch a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has branch"@en , "지지 보유"@ko ;
    rdfs:domain saju:Pillar ;
    rdfs:range  saju:EarthlyBranch .

saju:hasElement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has element"@en , "오행 보유"@ko ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( saju:HeavenlyStem saju:EarthlyBranch ) ] ;
    rdfs:range  saju:FiveElement .

saju:hasPolarity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has polarity"@en , "음양 속성"@ko ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( saju:HeavenlyStem saju:EarthlyBranch ) ] ;
    rdfs:range  saju:Polarity .

saju:generates a owl:ObjectProperty ;
    rdfs:label "generates"@en , "상생(相生)"@ko ;
    rdfs:domain saju:FiveElement ;
    rdfs:range  saju:FiveElement ;
    rdfs:comment "Generative cycle: Wood→Fire→Earth→Metal→Water→Wood."@en .

saju:controls a owl:ObjectProperty ;
    rdfs:label "controls"@en , "상극(相剋)"@ko ;
    rdfs:domain saju:FiveElement ;
    rdfs:range  saju:FiveElement ;
    rdfs:comment "Controlling cycle: Wood→Earth→Water→Fire→Metal→Wood."@en .

saju:combinesWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "combines with"@en , "합(合)"@ko ;
    rdfs:comment "Stems or branches that bond together."@en .

saju:clashesWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "clashes with"@en , "충(沖)"@ko ;
    rdfs:comment "Branches in opposite positions that conflict."@en .

saju:transformsInto a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transforms into"@en , "합화(合化)"@ko ;
    rdfs:comment "The five element produced when a combination fully transforms."@en ;
    rdfs:domain saju:Combination ;
    rdfs:range  saju:FiveElement .

saju:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en , "참여"@ko ;
    rdfs:comment "A stem or branch is a member of a combination or clash."@en .

saju:hiddenStem a owl:ObjectProperty ;
    rdfs:label "hidden stem"@en , "지장간(支藏干)"@ko ;
    rdfs:domain saju:EarthlyBranch ;
    rdfs:range  saju:HeavenlyStem ;
    rdfs:comment "Heavenly stems concealed within an earthly branch."@en .


#==============================================================================
# DATA PROPERTIES
#==============================================================================

saju:hanja a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hanja (Chinese character)"@en , "한자"@ko ;
    rdfs:range xsd:string .

saju:hangul a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hangul (Korean reading)"@en , "한글"@ko ;
    rdfs:range xsd:string .

saju:cycleIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle index"@en , "60갑자 순번"@ko ;
    rdfs:domain saju:Pillar ;
    rdfs:range xsd:integer ;
    rdfs:comment "Position in the sexagenary cycle (1–60)."@en .

#==============================================================================
# ENUM-LIKE INSTANCES — POLARITY
#==============================================================================

saju:Yang a saju:Polarity ;
    rdfs:label "Yang"@en , "양(陽)"@ko .

saju:Yin a saju:Polarity ;
    rdfs:label "Yin"@en , "음(陰)"@ko .


#==============================================================================
# ENUM-LIKE INSTANCES — FIVE ELEMENTS
#==============================================================================

saju:Wood  a saju:FiveElement ; rdfs:label "Wood"@en  , "목(木)"@ko .
saju:Fire  a saju:FiveElement ; rdfs:label "Fire"@en  , "화(火)"@ko .
saju:Earth a saju:FiveElement ; rdfs:label "Earth"@en , "토(土)"@ko .
saju:Metal a saju:FiveElement ; rdfs:label "Metal"@en , "금(金)"@ko .
saju:Water a saju:FiveElement ; rdfs:label "Water"@en , "수(水)"@ko .

# Generative cycle (상생): Wood → Fire → Earth → Metal → Water → Wood
saju:Wood  saju:generates saju:Fire  .
saju:Fire  saju:generates saju:Earth .
saju:Earth saju:generates saju:Metal .
saju:Metal saju:generates saju:Water .
saju:Water saju:generates saju:Wood  .

# Controlling cycle (상극): Wood → Earth → Water → Fire → Metal → Wood
saju:Wood  saju:controls saju:Earth .
saju:Earth saju:controls saju:Water .
saju:Water saju:controls saju:Fire  .
saju:Fire  saju:controls saju:Metal .
saju:Metal saju:controls saju:Wood  .

#==============================================================================
# HEAVENLY STEM INSTANCES (10천간)
#==============================================================================

saju:Stem_갑 a saju:HeavenlyStem ;
    rdfs:label "Jia (Yang Wood)"@en , "갑(甲)"@ko ;
    saju:hanja "甲" ; saju:hangul "갑" ;
    saju:hasElement saju:Wood ; saju:hasPolarity saju:Yang .

saju:Stem_을 a saju:HeavenlyStem ;
    rdfs:label "Yi (Yin Wood)"@en , "을(乙)"@ko ;
    saju:hanja "乙" ; saju:hangul "을" ;
    saju:hasElement saju:Wood ; saju:hasPolarity saju:Yin .

saju:Stem_병 a saju:HeavenlyStem ;
    rdfs:label "Bing (Yang Fire)"@en , "병(丙)"@ko ;
    saju:hanja "丙" ; saju:hangul "병" ;
    saju:hasElement saju:Fire ; saju:hasPolarity saju:Yang .

saju:Stem_정 a saju:HeavenlyStem ;
    rdfs:label "Ding (Yin Fire)"@en , "정(丁)"@ko ;
    saju:hanja "丁" ; saju:hangul "정" ;
    saju:hasElement saju:Fire ; saju:hasPolarity saju:Yin .

saju:Stem_무 a saju:HeavenlyStem ;
    rdfs:label "Wu (Yang Earth)"@en , "무(戊)"@ko ;
    saju:hanja "戊" ; saju:hangul "무" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yang .

saju:Stem_기 a saju:HeavenlyStem ;
    rdfs:label "Ji (Yin Earth)"@en , "기(己)"@ko ;
    saju:hanja "己" ; saju:hangul "기" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yin .

saju:Stem_경 a saju:HeavenlyStem ;
    rdfs:label "Geng (Yang Metal)"@en , "경(庚)"@ko ;
    saju:hanja "庚" ; saju:hangul "경" ;
    saju:hasElement saju:Metal ; saju:hasPolarity saju:Yang .

saju:Stem_신 a saju:HeavenlyStem ;
    rdfs:label "Xin (Yin Metal)"@en , "신(辛)"@ko ;
    saju:hanja "辛" ; saju:hangul "신" ;
    saju:hasElement saju:Metal ; saju:hasPolarity saju:Yin .

saju:Stem_임 a saju:HeavenlyStem ;
    rdfs:label "Ren (Yang Water)"@en , "임(壬)"@ko ;
    saju:hanja "壬" ; saju:hangul "임" ;
    saju:hasElement saju:Water ; saju:hasPolarity saju:Yang .

saju:Stem_계 a saju:HeavenlyStem ;
    rdfs:label "Gui (Yin Water)"@en , "계(癸)"@ko ;
    saju:hanja "癸" ; saju:hangul "계" ;
    saju:hasElement saju:Water ; saju:hasPolarity saju:Yin .


#==============================================================================
# EARTHLY BRANCH INSTANCES (12지지)
#==============================================================================

saju:Branch_자 a saju:EarthlyBranch ;
    rdfs:label "Zi (Rat / Yang Water)"@en , "자(子)"@ko ;
    saju:hanja "子" ; saju:hangul "자" ;
    saju:hasElement saju:Water ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_계 .

saju:Branch_축 a saju:EarthlyBranch ;
    rdfs:label "Chou (Ox / Yin Earth)"@en , "축(丑)"@ko ;
    saju:hanja "丑" ; saju:hangul "축" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_기 , saju:Stem_계 , saju:Stem_신 .

saju:Branch_인 a saju:EarthlyBranch ;
    rdfs:label "Yin (Tiger / Yang Wood)"@en , "인(寅)"@ko ;
    saju:hanja "寅" ; saju:hangul "인" ;
    saju:hasElement saju:Wood ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_갑 , saju:Stem_병 , saju:Stem_무 .

saju:Branch_묘 a saju:EarthlyBranch ;
    rdfs:label "Mao (Rabbit / Yin Wood)"@en , "묘(卯)"@ko ;
    saju:hanja "卯" ; saju:hangul "묘" ;
    saju:hasElement saju:Wood ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_을 .

saju:Branch_진 a saju:EarthlyBranch ;
    rdfs:label "Chen (Dragon / Yang Earth)"@en , "진(辰)"@ko ;
    saju:hanja "辰" ; saju:hangul "진" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_무 , saju:Stem_을 , saju:Stem_계 .

saju:Branch_사 a saju:EarthlyBranch ;
    rdfs:label "Si (Snake / Yin Fire)"@en , "사(巳)"@ko ;
    saju:hanja "巳" ; saju:hangul "사" ;
    saju:hasElement saju:Fire ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_병 , saju:Stem_무 , saju:Stem_경 .

saju:Branch_오 a saju:EarthlyBranch ;
    rdfs:label "Wu (Horse / Yang Fire)"@en , "오(午)"@ko ;
    saju:hanja "午" ; saju:hangul "오" ;
    saju:hasElement saju:Fire ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_정 , saju:Stem_기 .

saju:Branch_미 a saju:EarthlyBranch ;
    rdfs:label "Wei (Goat / Yin Earth)"@en , "미(未)"@ko ;
    saju:hanja "未" ; saju:hangul "미" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_기 , saju:Stem_정 , saju:Stem_을 .

saju:Branch_신 a saju:EarthlyBranch ;
    rdfs:label "Shen (Monkey / Yang Metal)"@en , "신(申)"@ko ;
    saju:hanja "申" ; saju:hangul "신" ;
    saju:hasElement saju:Metal ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_경 , saju:Stem_임 , saju:Stem_무 .

saju:Branch_유 a saju:EarthlyBranch ;
    rdfs:label "You (Rooster / Yin Metal)"@en , "유(酉)"@ko ;
    saju:hanja "酉" ; saju:hangul "유" ;
    saju:hasElement saju:Metal ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_신 .

saju:Branch_술 a saju:EarthlyBranch ;
    rdfs:label "Xu (Dog / Yang Earth)"@en , "술(戌)"@ko ;
    saju:hanja "戌" ; saju:hangul "술" ;
    saju:hasElement saju:Earth ; saju:hasPolarity saju:Yang ;
    saju:hiddenStem saju:Stem_무 , saju:Stem_신 , saju:Stem_정 .

saju:Branch_해 a saju:EarthlyBranch ;
    rdfs:label "Hai (Pig / Yin Water)"@en , "해(亥)"@ko ;
    saju:hanja "亥" ; saju:hangul "해" ;
    saju:hasElement saju:Water ; saju:hasPolarity saju:Yin ;
    saju:hiddenStem saju:Stem_임 , saju:Stem_갑 .

#==============================================================================
# 60 SEXAGENARY PILLAR INSTANCES (60갑자)
# Auto-generated. The standard sequence: 갑자, 을축, 병인, ...
#==============================================================================

saju:Pillar_갑자 a saju:Pillar ;
    rdfs:label "甲子"@en , "갑자(甲子)"@ko ;
    saju:hanja "甲子" ; saju:hangul "갑자" ;
    saju:hasStem saju:Stem_갑 ;
    saju:hasBranch saju:Branch_자 ;
    saju:cycleIndex 1 .

