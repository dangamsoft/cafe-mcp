    saju:hasStem saju:Stem_경 ;
    saju:hasBranch saju:Branch_진 ;
    saju:cycleIndex 17 .

saju:Pillar_신사 a saju:Pillar ;
    rdfs:label "辛巳"@en , "신사(辛巳)"@ko ;
